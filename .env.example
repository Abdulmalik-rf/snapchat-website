# ---------- النشر عبر Docker/Caddy (VPS) ----------
# النطاق الذي يخدمه Caddy (النطاق المؤقت للـ VPS أو نطاقك الحقيقي)
# (للـ VPS فقط) SITE_DOMAIN=srvXXXXXX.hstgr.cloud

# ---------- عام ----------
# رابط الموقع النهائي (بدون / في النهاية) — يُستخدم في الـ SEO والروابط داخل البريد
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# رقم واتساب بصيغة دولية بدون +
NEXT_PUBLIC_WHATSAPP_NUMBER=9665XXXXXXXX
# رابط متجر سلة (للفوتر)
NEXT_PUBLIC_SALLA_STORE_URL=https://your-store.salla.sa

# ---------- فيديو الخلفية (اختياري — انظر docs/VIDEO.md) ----------
# NEXT_PUBLIC_BG_VIDEO=/video/bg.mp4
# NEXT_PUBLIC_BG_VIDEO_WEBM=/video/bg.webm
# NEXT_PUBLIC_BG_POSTER=/video/poster.jpg
# scrub = يتقدّم مع التمرير | autoplay = تشغيل تلقائي صامت
# NEXT_PUBLIC_BG_MODE=scrub

# ---------- منتجات سلة (رابط منتج لكل باقة) ----------
SALLA_PRODUCT_URL_ANALYSIS=https://your-store.salla.sa/p/xxxxxxx
SALLA_PRODUCT_URL_PLAN=https://your-store.salla.sa/p/yyyyyyy
SALLA_PRODUCT_URL_EXPERT=https://your-store.salla.sa/p/zzzzzzz

# ---------- Webhook سلة (انظر docs/SALLA-SETUP.md) ----------
SALLA_WEBHOOK_SECRET=change-me
# auto | signature | token
SALLA_WEBHOOK_STRATEGY=auto
# الأحداث التي تُطلق بريد الشكر (افتراضي مناسب لمعظم المتاجر)
# SALLA_TRIGGER_EVENTS=order.created,order.status.updated,order.payment.updated
# حالات الطلب التي لا نرسل عندها
# SALLA_SKIP_STATUSES=payment_pending,canceled,cancelled,restored,restoring

# ---------- البريد (Resend) ----------
RESEND_API_KEY=re_xxxxxxxxx
# يجب أن يكون النطاق مُتحقَّقًا في Resend
EMAIL_FROM="SnapReady <no-reply@your-domain.com>"
# بريد الإدارة الذي يستقبل النماذج والطلبات المدفوعة
ADMIN_EMAIL=owner@your-domain.com

# ---------- التخزين (Upstash Redis — مجاني) ----------
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ---------- WhatsApp Cloud API (اختياري) ----------
# WHATSAPP_TOKEN=EAAB...
# WHATSAPP_PHONE_ID=1234567890
# WHATSAPP_TEMPLATE_NAME=order_received
# WHATSAPP_TEMPLATE_LANG=ar
